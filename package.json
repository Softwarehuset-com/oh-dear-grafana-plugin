{
  "name": "oh-dear",
  "version": "1.0.1",
  "description": "Grafana data source plugin for Oh Dear uptime, downtime, performance and Lighthouse monitoring.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Softwarehuset-com/oh-dear-grafana-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Softwarehuset-com/oh-dear-grafana-plugin/issues"
  },
  "homepage": "https://github.com/Softwarehuset-com/oh-dear-grafana-plugin",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "npx -y @grafana/sign-plugin@latest"
  },
  "author": "Softwarehuset",
  "license": "MIT",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.15.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.13",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.2.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.1.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.105.1",
    "sass-loader": "^16.0.0",
    "semver": "^7.8.5",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.2.3",
    "@grafana/i18n": "13.2.3",
    "@grafana/runtime": "13.2.3",
    "@grafana/schema": "13.2.3",
    "@grafana/ui": "13.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "source-map-js": "1.2.2",
    "js-cookie": "^3.0.0"
  }
}
